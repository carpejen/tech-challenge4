      "name": "01 - Sem API Key - 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Teste sem API key\",\n  \"nota\": 9\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/avaliacao",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "avaliacao"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
